---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const youtubeEmbed = 'https://www.youtube.com/embed/dPB5DjMyOSg';

const layout = [
  { type: 'full', src: `${base}images/APPETITE_STILL01.png`, alt: 'Appetite Still 01' },
  { type: 'full', src: `${base}images/APPETITE_STILL02.png`, alt: 'Appetite Still 02' },
  { type: 'full', src: `${base}images/APPETITE_STILL04.png`, alt: 'Appetite Still 04' },
];
---

<Layout title="Appetite — Laura Alvarez">
  <header>
    <a href={base} class="back">← Laura Alvarez</a>
  </header>

  <main>
    <div class="info">
      <div class="credits">
        <div class="credits-col description-block">
          <h1>Appetite</h1>
          <p class="description">A salaryman feasts on an abundant meal with an unexpected twist.</p>
          <p class="description">A spec commercial for Pearl, a fictional brand of premium earbuds, and our entry to the Musicbed challenge.</p>
        </div>
        <div></div>
      </div>

      <div class="credits">

        <!-- Column 1 -->
        <div class="credits-col">
          <div class="credit-row"><span class="label">Type</span><span>Spec Ad</span></div>
          <div class="credit-row"><span class="label">Year</span><span>2026</span></div>

          <div class="credit-divider"></div>

          <div class="credit-section-label">Direction & Production</div>
          <div class="credit-row"><span class="label">Directed & Produced</span><span>Laura Álvarez Cadena</span></div>
          <div class="credit-row"><span class="label">Directed & Produced</span><span>Luis G. Grech</span></div>

          <div class="credit-divider"></div>

          <div class="credit-section-label">Camera</div>
          <div class="credit-row"><span class="label">Director of Photography</span><span>Anran Chen</span></div>
          <div class="credit-row"><span class="label">1st AC</span><span>Javier Vizarreta</span></div>
          <div class="credit-row"><span class="label">2nd AC</span><span>Jonathan Hornby</span></div>
          <div class="credit-row"><span class="label">Gaffer</span><span>Nico Cauton</span></div>
          <div class="credit-row"><span class="label">Grip</span><span>Jeff Yang</span></div>
          <div class="credit-row"><span class="label">Grip</span><span>Calvin</span></div>
        </div>

        <!-- Column 2 -->
        <div class="credits-col">
          <div class="credit-section-label">Art Department</div>
          <div class="credit-row"><span class="label">Production Designer</span><span>Eron Kumar</span></div>
          <div class="credit-row"><span class="label">Art Director</span><span>Adriana Donca</span></div>
          <div class="credit-row"><span class="label">Styling</span><span>Indiana Martín</span></div>

          <div class="credit-divider"></div>

          <div class="credit-section-label">Post Production</div>
          <div class="credit-row"><span class="label">Sound Design</span><span>Santiago Amézquita</span></div>
          <div class="credit-row"><span class="label">Color</span><span>Jeff Yang</span></div>
          <div class="credit-row"><span class="label">3D Artist</span><span>Eron Kumar</span></div>

          <div class="credit-divider"></div>

          <div class="credit-section-label">Music</div>
          <div class="credit-row"><span class="label">Song</span><span>Anitra's Dance (Via Musicbed)</span></div>
        </div>

        <!-- Column 3 -->
        <div class="credits-col">
          <div class="credit-section-label">Casting</div>
          <div class="credit-row"><span class="label">Key Cast</span><span>Andrew Hu</span></div>
          <div class="credit-row"><span class="label">Supporting Cast</span><span>Adriana Donca</span></div>
          <div class="credit-row"><span class="label">Supporting Cast</span><span>Evangelos Koutsioumpas</span></div>
          <div class="credit-row"><span class="label">Supporting Cast</span><span>Jack London Freedman</span></div>
          <div class="credit-row"><span class="label">Supporting Cast</span><span>Hsiao-Chiao Peng</span></div>
        </div>

      </div>
    </div>

    {youtubeEmbed && (
      <div class="video-wrap">
        <iframe
          src={youtubeEmbed}
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          title="Appetite — Laura Alvarez"
        />
      </div>
    )}

    <div class="images">
      {layout.map((item) => (
        <img src={item.src} alt={item.alt} class="full" />
      ))}
    </div>
  </main>

  <footer>
    <span>Laura Alvarez — Director</span>
    <span>© 2026 All rights reserved</span>
  </footer>
</Layout>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 20px 24px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
  }

  .back {
    font-size: 12px;
    color: #707070;
    transition: color 0.15s;
  }

  .back:hover {
    color: #1a1a1a;
  }

  main {
    padding-top: 56px;
  }

  .video-wrap {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    background: #000;
    margin-bottom: 8px;
  }

  .video-wrap iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
  }

  .images {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .images img.full {
    width: 100%;
    height: auto;
    display: block;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 40px 24px 80px;
    max-width: 1200px;
    margin-inline: auto;
    box-sizing: border-box;
  }

  h1 {
    font-size: 12px;
    font-weight: 400;
    margin-bottom: 12px;
    color: #1a1a1a;
  }

  .description {
    font-size: 12px;
    line-height: 1.6;
    color: #707070;
  }

  .credits {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0 3rem;
    align-items: start;
  }

  .credits-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .description-block {
    grid-column: span 2;
  }

  .credit-section-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1a1a1a;
    margin-top: 4px;
    margin-bottom: 2px;
  }

  .credit-row {
    display: flex;
    gap: 1rem;
    font-size: 12px;
    color: #707070;
  }

  .label {
    width: 160px;
    flex-shrink: 0;
    color: #1a1a1a;
  }

  .credit-divider {
    border-top: 1px solid #e0e0e0;
    margin-block: 8px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    padding: 20px 24px;
    border-top: 1px solid #e0e0e0;
    font-size: 11px;
    color: #707070;
  }

  @media (max-width: 768px) {
    .info {
      padding: 28px 20px 48px;
    }

    .credits {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .credit-row {
      flex-direction: column;
      gap: 2px;
    }

    .label {
      min-width: unset;
    }

    footer {
      flex-direction: column;
      align-items: center;
      gap: 4px;
      text-align: center;
    }
  }
</style>
